<?xml version="1.0" encoding="utf-8"?>
<!-- Lateral docked pill surface for left screen edge. Flat on left, rounded on right. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/colorPrimaryContainer" />
    <corners
        android:topLeftRadius="0dp"
        android:bottomLeftRadius="0dp"
        android:topRightRadius="@dimen/m3_shape_corner_large_increased"
        android:bottomRightRadius="@dimen/m3_shape_corner_large_increased" />
</shape>
